# 复制为 .env 后按本机环境修改（.env 已被 .gitignore 忽略）

# 服务监听端口
PORT=4000

# 运行环境：development | production
NODE_ENV=development

# MongoDB 连接串（本地默认地址；使用 Atlas 时替换为 mongodb+srv://...）
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB 数据库名
MONGODB_DB=yiyan_testament

# 允许跨域访问的前端来源，多个用英文逗号分隔，* 表示不限制
CORS_ORIGIN=http://localhost:5173

# 前端构建产物目录（相对 backend/ 目录），生产模式下由后端直接托管
FRONTEND_DIST=../frontend/dist

# 重试写入（单节点 mongod 建议保持 false；副本集/Atlas 可设为 true）
MONGO_RETRY_WRITES=false
